{
  "lineWidth": 120,
  "includes": [
    "**/*.swift",
    "**/*.md",
    "**/*.json",
    "**/*.yaml",
    "**/*.yml"
  ],
  "excludes": [
    "**/build/**",
    "**/DerivedData/**",
    "**/site/**",
    "**/Images.xcassets/**",
    "**/secrets/**"
  ],
  "swiftformat": {
    "swiftVersion": "5.0"
  },
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/json-0.22.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/drluckyspin/swift-v0.1.0.json",
  ]
}
